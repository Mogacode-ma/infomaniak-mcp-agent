# Infomaniak MCP Agent — environment configuration
# Copy this file to .env and fill in your own values.
# .env is gitignored — never commit your real credentials.

# ============================================================
# REQUIRED — Public API (Bearer token)
# ============================================================
# Generate at: https://manager.infomaniak.com/v3/ng/profile/user/token/list
# Used for: read-only operations on api.infomaniak.com
INFOMANIAK_API_TOKEN=your_api_token_here

# ============================================================
# OPTIONAL — Manager private API (for write operations)
# ============================================================
# Two ways to authenticate against manager.infomaniak.com/proxy/...
#
# Mode 1: AUTO (recommended) — extract cookies from your local Chrome
# Just be logged into https://manager.infomaniak.com in Chrome.
# The MCP will read SASESSION + MANAGER-XSRF-TOKEN automatically.
INFOMANIAK_AUTH_MODE=auto

# Mode 2: MANUAL — paste cookies yourself if auto extraction fails
# (e.g. on a server without Chrome, or for CI/testing)
# INFOMANIAK_AUTH_MODE=manual
# INFOMANIAK_SASESSION=
# INFOMANIAK_XSRF_TOKEN=

# ============================================================
# OPTIONAL — Logging & behavior
# ============================================================
# pino log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Confirmation token TTL for destructive operations (seconds)
CONFIRMATION_TTL_SECONDS=60

# Rate limit (default 60 req/min — Infomaniak hard limit, do not raise)
RATE_LIMIT_PER_MINUTE=60
